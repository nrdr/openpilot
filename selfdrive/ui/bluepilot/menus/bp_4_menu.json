{
  "type": "navigation",
  "menuName": "BluePilot",
  "menuIcon": "icon_ford.png",
  "menuDescription": "BluePilot Panel",
  "equalWidth": true,
  "iconPosition": "top",
  "tabs": [
    {
      "name": "Debug",
      "icon": "../assets/offroad/icon_debug.png",
      "groups": [
        {
          "groupName": "paramViewerGroup",
          "title": "Parameter Viewer",
          "enableResetButton": false,
          "controls": [
            {
              "type": "param_list_viewer",
              "title": "All Parameters",
              "desc": "View all available parameters in the system",
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "param_viewer",
              "param": "LiveParameters",
              "title": "Live Parameters",
              "desc": "Displays live parameters",
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            }
          ]
        },
        {
          "groupName": "debugPreferencesGroup",
          "title": "Debug Preferences:",
          "enableResetButton": false,
          "keepScreenAwake": true,
          "controls": [
            {
              "type": "toggle",
              "param": "FordPrefEnableDebugLogs",
              "title": "Enable Debug Logging",
              "desc": "Enable this to collect more detailed logs for the route."
            }
          ],
          "conditions": {
            "git_remote": ["ford-op/sp-dev-c3"],
            "git_branch": []
          }
        },
        {
          "groupName": "utilityCommandsGroup",
          "title": "Utility Commands:",
          "enableResetButton": false,
          "controls": [
            {
              "type": "command_button",
              "command": "echo \"Starting process...\" && for i in {1..5}; do echo \"[$(date '+%H:%M:%S')] Processing batch $i/5...\"; sleep 1; echo \"  -> Completed subtask $i\"; sleep 1; done && echo \"All tasks completed successfully!\"",
              "working_dir": "/data/openpilot",
              "title": "Test Command",
              "desc": "Test Command",
              "button_text": "Test Command",
              "confirm": true,
              "confirm_text": "Are you sure you want to run this command?",
              "confirm_button_text": "Run",
              "cancel_button_text": "Cancel",
              "hidden": true,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "command_button",
              "command": "wget https://raw.githubusercontent.com/tonesto7/op-utilities/main/CommaUtility.sh && chmod +x /data/CommaUtility.sh",
              "working_dir": "/data",
              "title": "Install Comma Utility",
              "desc": "Install Comma Utility",
              "button_text": "Install",
              "confirm": false,
              "hidden": false,
              "OnlyOnCommaDevice": true,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "file_viewer",
              "path": "/data/community/crashes/error.txt",
              "title": "Recent Crashes",
              "desc": "View the crashes file",
              "button_text": "View Error",
              "confirm": false,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "file_viewer",
              "path": "/data/logs/bp_logger/bluepilot.log",
              "title": "BluePilot Log",
              "desc": "View the BluePilot log",
              "button_text": "View Log",
              "confirm": false,
              "hidden": true,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            },
            {
              "type": "command_button",
              "command": "ifconfig",
              "working_dir": "/data/openpilot",
              "title": "Get Network Info",
              "desc": "Get network info using ifconfig",
              "button_text": "Get Info",
              "confirm": false,
              "hidden": false,
              "conditions": {
                "git_remote": ["ford-op/sp-dev-c3"],
                "git_branch": []
              }
            }
          ]
        }
      ]
    }
  ]
}
